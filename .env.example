# ==========================================
# DataMboa LMS — Environment Configuration Template
# DO NOT store real secrets in this file.
# Copy this file to .env for local development.
# ==========================================

# ------------------------------------------
# Django Backend Configuration
# ------------------------------------------
DJANGO_SECRET_KEY=insecure-dev-key-change-in-production-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
# Local development URL:
DATABASE_URL=postgres://lms_user:lms_password@localhost:5432/lms_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# Next.js Frontend Configuration
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr
